# Copier en .env puis coller la clé ElevenLabs après le signe égal (ne jamais la committer ni la coller dans un chat).
ELEVENLABS_API_KEY=

# Comptes (facultatif) : à mettre dans .env.local (jamais committé), valeurs de Supabase
# → Project Settings → API Keys. L'URL et la clé publique (sb_publishable_…, ou l'ancienne « anon »)
# sont publiques par conception (les tables sont protégées : supabase/migrations).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Écoles : adresse affichée à la fin d'un essai (publique, elle part dans le build).
VITE_CONTACT_EMAIL=

# Écoles, scripts locaux seulement (npm run school) : la clé secrète (sb_secret_…, ou l'ancienne
# « service_role »). Uniquement dans .env.local, JAMAIS préfixée VITE_ (elle partirait dans le build),
# jamais dans le dépôt ni dans un chat. Voir docs/ADMIN.md.
SUPABASE_SECRET_KEY=
