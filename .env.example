# Copier en .env puis coller la clé ElevenLabs après le signe égal (ne jamais la committer ni la coller dans un chat).
ELEVENLABS_API_KEY=

# Comptes (facultatif) : à mettre dans .env.local (jamais committé), valeurs de Supabase
# → Project Settings → API. L'URL et la clé « anon public » sont publiques par conception
# (la table est protégée par supabase/schema.sql) ; ne jamais mettre ici la clé « service_role ».
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
